{
  "private": true,
  "name": "silent-lambs",
  "version": "1.0.0",
  "description": "Don't let lambs cry — a tap game for Reddit",
  "license": "ISC",
  "author": "Shawn Jung",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shawnjung/Silence-of-the-lambs.git"
  },
  "scripts": {
    "build": "vite build",
    "deploy": "npm run test:types && npm run lint && devvit upload",
    "dev": "devvit playtest",
    "launch": "npm run deploy && devvit publish",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "login": "devvit login",
    "prettier": "prettier --write .",
    "test:types": "tsc --build",
    "test:unit": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test \"src/**/*.test.ts\""
  },
  "engines": {
    "node": ">=22.20.0"
  },
  "dependencies": {
    "@devvit/start": "0.13.11",
    "@devvit/web": "0.13.11",
    "@hono/node-server": "2.0.12",
    "devvit": "0.13.11",
    "hono": "4.12.32",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^22.19.19",
    "eslint": "10.8.0",
    "globals": "17.8.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5"
  }
}
